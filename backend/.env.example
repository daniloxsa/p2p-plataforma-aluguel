# Configuracao de conexao com o PostgreSQL (fonte de verdade: univia_db)
# Substitua USUARIO e SENHA pelas credenciais reais do PostgreSQL local.
# Nao comite este arquivo com credenciais reais.
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/univia_db?schema=public"

# Porta da API NestJS
PORT=3000

# Origens permitidas pelo CORS (separadas por virgula)
CORS_ORIGINS="http://localhost:5173,https://p2p-plataforma-aluguel.vercel.app"
