/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model anuncio {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  veiculo_id               String                     @unique(map: "uq_anuncio_ativo_veiculo", where: raw("((status)::text = 'ATIVO'::text)")) @db.Uuid
  titulo                   String                     @db.VarChar(150)
  descricao                String?
  preco_diaria             Decimal                    @db.Decimal(12, 2)
  valor_caucao             Decimal                    @default(0) @db.Decimal(12, 2)
  preco_seguro_dia         Decimal                    @default(0) @db.Decimal(12, 2)
  aceite_automatico        Boolean                    @default(false)
  status                   String                     @default("RASCUNHO") @db.VarChar(30)
  criado_em                DateTime                   @default(now()) @db.Timestamptz(6)
  veiculo                  veiculo                    @relation(fields: [veiculo_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_anuncio_veiculo")
  bloqueio_disponibilidade bloqueio_disponibilidade[]
  reserva                  reserva[]

  @@index([status, preco_diaria], map: "idx_anuncio_status_preco")
  @@index([veiculo_id], map: "idx_anuncio_veiculo")
}

